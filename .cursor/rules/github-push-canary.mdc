```applescript
tell application "Google Chrome Canary"
  activate
  if (count of windows) = 0 then
    make new window
  end if
  tell front window
    set newTab to make new tab with properties {URL:"https://github.com/login/device"}
  end tell
  set active tab index of front window to (count of tabs of front window)
  activate
end tell
